#!/usr/bin/env bash
# housekeep — audit a dev folder for space, security, and git hygiene.
set -uo pipefail

CACHE_PATTERNS=(node_modules .venv venv __pycache__ .next dist build target .gradle DerivedData .turbo)

usage() {
  cat <<'EOF'
usage: housekeep [space|security|git|fix] [path] [--clean] [--json]

  housekeep [path]                 run all three checks (default path: .)
  housekeep space [path] [--clean] reclaimable cache/build dirs (--clean prompts per dir)
  housekeep security [path]        gitleaks + osv-scanner across git projects
  housekeep git [path]             uncommitted/unpushed/no-remote status
  housekeep fix [path]             interactive: walk every finding, choose an action per item

  --json   emit structured JSON instead of a table (any subcommand)
EOF
}

CMD="all"
ROOT="."
CLEAN=0
JSON=0

for arg in "$@"; do
  case "$arg" in
    space|security|git|fix) CMD="$arg" ;;
    --clean) CLEAN=1 ;;
    --json) JSON=1 ;;
    -h|--help) usage; exit 0 ;;
    *) ROOT="$arg" ;;
  esac
done

[ -d "$ROOT" ] || { echo "housekeep: no such directory: $ROOT" >&2; exit 1; }
ROOT=$(cd "$ROOT" && pwd)

is_project_root() {
  local d="$1"
  for p in "${CACHE_PATTERNS[@]}"; do
    [[ "$(basename "$d")" == "$p" ]] && return 1
  done
  return 0
}

# ---------- space ----------
run_space() {
  local rows=() total_kb=0
  while IFS= read -r -d '' hit; do
    local kb size
    kb=$(du -sk "$hit" 2>/dev/null | cut -f1)
    [ -z "$kb" ] && continue
    size=$(du -sh "$hit" 2>/dev/null | cut -f1)
    total_kb=$((total_kb + kb))
    rows+=("$kb|$size|$hit")
  done < <(find "$ROOT" -mindepth 1 -maxdepth 4 \( \
      -iname node_modules -o -iname .venv -o -iname venv -o -iname __pycache__ \
      -o -iname .next -o -iname dist -o -iname build -o -iname target \
      -o -iname .gradle -o -iname DerivedData -o -iname .turbo \
    \) -not -path '*/node_modules/*' -print0 2>/dev/null)

  if [ "${#rows[@]}" -gt 0 ]; then
    IFS=$'\n' rows=($(printf '%s\n' "${rows[@]}" | sort -t'|' -k1,1 -rn))
    unset IFS
  fi

  local n_rows=0
  [ -n "${rows:-}" ] && n_rows="${#rows[@]}"

  if [ "$JSON" -eq 1 ]; then
    printf '{"total_kb":%d,"dirs":[' "$total_kb"
    local first=1 i
    for ((i=0; i<n_rows; i++)); do
      IFS='|' read -r kb size path <<<"${rows[$i]}"
      [ "$first" -eq 1 ] && first=0 || printf ','
      printf '{"path":%s,"size":"%s","kb":%s}' "$(printf '%s' "$path" | python3 -c 'import json,sys;print(json.dumps(sys.stdin.read()))')" "$size" "$kb"
    done
    printf ']}\n'
    return
  fi

  echo "== space =="
  printf '%-10s  %s\n' "SIZE" "PATH"
  local i
  for ((i=0; i<n_rows; i++)); do
    IFS='|' read -r kb size path <<<"${rows[$i]}"
    printf '%-10s  %s\n' "$size" "${path#$ROOT/}"
  done
  printf 'total: %s reclaimable across %d dirs\n' "$(numfmt --to=iec --from-unit=1024 "$total_kb" 2>/dev/null || echo "${total_kb}K")" "$n_rows"

  # duplicate venv + .venv warning
  find "$ROOT" -mindepth 1 -maxdepth 3 -type d -iname .venv -print0 2>/dev/null | while IFS= read -r -d '' dv; do
    local parent siblingvenv
    parent=$(dirname "$dv")
    siblingvenv="$parent/venv"
    [ -d "$siblingvenv" ] && echo "WARNING: duplicate venv+.venv in ${parent#$ROOT/}"
  done

  if [ "$CLEAN" -eq 1 ]; then
    echo
    for ((i=0; i<n_rows; i++)); do
      IFS='|' read -r kb size path <<<"${rows[$i]}"
      read -r -p "Delete $path ($size)? [y/N] " ans
      [[ "$ans" =~ ^[Yy]$ ]] && rm -rf "$path" && echo "removed $path"
    done
  fi
}

# ---------- security ----------
run_security() {
  local have_gitleaks=1 have_osv=1
  command -v gitleaks >/dev/null 2>&1 || have_gitleaks=0
  command -v osv-scanner >/dev/null 2>&1 || have_osv=0

  if [ "$have_gitleaks" -eq 0 ] || [ "$have_osv" -eq 0 ]; then
    echo "housekeep: missing security tools. Install with:" >&2
    echo "  brew install gitleaks osv-scanner" >&2
    [ "$have_gitleaks" -eq 0 ] && [ "$have_osv" -eq 0 ] && return 1
  fi

  [ "$JSON" -eq 0 ] && echo "== security =="

  while IFS= read -r -d '' gitdir; do
    local proj="${gitdir%/.git}"
    local name="${proj#$ROOT/}"
    [ "$name" = "$proj" ] && name="."

    if [ "$have_gitleaks" -eq 1 ]; then
      local report="/tmp/housekeep_gitleaks.$$.json"
      gitleaks detect --source "$proj" --no-git --report-format json --report-path "$report" >/dev/null 2>&1
      if [ -s "$report" ] && [ "$(python3 -c "import json;print(len(json.load(open('$report'))))" 2>/dev/null)" != "0" ]; then
        echo "[$name] gitleaks: secrets found — run: gitleaks detect --source $proj --no-git -v"
      fi
      rm -f "$report"
    fi

    if [ "$have_osv" -eq 1 ]; then
      local vulns
      vulns=$(osv-scanner scan source "$proj" 2>/dev/null)
      if [ -n "$vulns" ] && echo "$vulns" | grep -qi "vulnerabilit"; then
        echo "[$name] osv-scanner: vulnerable dependencies found — run: osv-scanner scan source $proj"
      fi
    fi
  done < <(find "$ROOT" -mindepth 1 -maxdepth 4 -type d -iname .git -not -path '*/node_modules/*' -print0 2>/dev/null)
}

# ---------- git ----------
run_git() {
  local rows=()
  while IFS= read -r -d '' gitdir; do
    local proj="${gitdir%/.git}"
    local name="${proj#$ROOT/}"
    [ "$name" = "$proj" ] && name="."
    (
      cd "$proj" || exit
      local dirty branch upstream ahead
      dirty=$(git status --porcelain 2>/dev/null | wc -l | tr -d ' ')
      branch=$(git branch --show-current 2>/dev/null)
      upstream=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null)
      ahead=$(git log @{u}.. --oneline 2>/dev/null | wc -l | tr -d ' ')
      printf '%s|%s|%s|%s|%s\n' "$name" "$dirty" "$branch" "${upstream:-NONE}" "${ahead:-0}"
    )
  done < <(find "$ROOT" -mindepth 1 -maxdepth 4 -type d -iname .git -not -path '*/node_modules/*' -print0 2>/dev/null) > /tmp/housekeep_git.$$

  if [ "$JSON" -eq 1 ]; then
    printf '{"repos":['
    local first=1
    while IFS='|' read -r name dirty branch upstream ahead; do
      [ "$first" -eq 1 ] && first=0 || printf ','
      printf '{"path":"%s","dirty":%s,"branch":"%s","upstream":"%s","unpushed":%s}' "$name" "$dirty" "$branch" "$upstream" "$ahead"
    done < /tmp/housekeep_git.$$
    printf ']}\n'
  else
    echo "== git =="
    printf '%-45s %6s  %-25s %-20s %s\n' "PATH" "DIRTY" "BRANCH" "UPSTREAM" "UNPUSHED"
    while IFS='|' read -r name dirty branch upstream ahead; do
      local flag=""
      [ "$dirty" -gt 0 ] && [ "$upstream" = "NONE" ] && flag=" <-- dirty, no remote"
      [ "$ahead" -gt 0 ] && flag="$flag <-- unpushed commits"
      printf '%-45s %6s  %-25s %-20s %s%s\n' "$name" "$dirty" "$branch" "$upstream" "$ahead" "$flag"
    done < /tmp/housekeep_git.$$
  fi
  rm -f /tmp/housekeep_git.$$
}

# ---------- fix (interactive) ----------
fix_space() {
  CLEAN=1 run_space
}

fix_git() {
  local rows=()
  while IFS= read -r -d '' gitdir; do
    local proj="${gitdir%/.git}"
    local name="${proj#$ROOT/}"
    [ "$name" = "$proj" ] && name="."
    (
      cd "$proj" || exit
      local dirty upstream ahead
      dirty=$(git status --porcelain 2>/dev/null | wc -l | tr -d ' ')
      upstream=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null)
      ahead=$(git log @{u}.. --oneline 2>/dev/null | wc -l | tr -d ' ')
      printf '%s|%s|%s|%s\n' "$name" "$dirty" "${upstream:-NONE}" "${ahead:-0}"
    )
  done < <(find "$ROOT" -mindepth 1 -maxdepth 4 -type d -iname .git -not -path '*/node_modules/*' -print0 2>/dev/null) > /tmp/housekeep_fixgit.$$

  while IFS='|' read -r -u 3 name dirty upstream ahead; do
    [ "$dirty" -eq 0 ] && [ "$ahead" -eq 0 ] && continue
    local proj="$ROOT/$name"
    [ "$name" = "." ] && proj="$ROOT"
    echo
    echo "-- $name --"
    [ "$dirty" -gt 0 ] && echo "  $dirty uncommitted change(s)"
    [ "$ahead" -gt 0 ] && echo "  $ahead unpushed commit(s)"
    [ "$upstream" = "NONE" ] && echo "  no upstream remote"
    echo "  [s]tatus  [d]iff  [c]ommit  [p]ush  [i]gnore/skip  [n]ext"
    read -r -p "  action> " act
    case "$act" in
      s) git -C "$proj" status ;;
      d) git -C "$proj" diff ;;
      c)
        git -C "$proj" status -s
        read -r -p "  commit message: " msg
        [ -n "$msg" ] && git -C "$proj" add -A && git -C "$proj" commit -m "$msg"
        ;;
      p)
        if [ "$upstream" = "NONE" ]; then
          echo "  no upstream configured, skipping push"
        else
          git -C "$proj" push
        fi
        ;;
      *) : ;;
    esac
  done 3< /tmp/housekeep_fixgit.$$
  rm -f /tmp/housekeep_fixgit.$$
}

fix_security() {
  local have_gitleaks=1
  command -v gitleaks >/dev/null 2>&1 || have_gitleaks=0
  [ "$have_gitleaks" -eq 0 ] && { echo "gitleaks not installed, skipping security fix pass" >&2; return; }

  local editor="${EDITOR:-open}"
  local gitdirs="/tmp/housekeep_fixsec_dirs.$$"
  find "$ROOT" -mindepth 1 -maxdepth 4 -type d -iname .git -not -path '*/node_modules/*' -print0 2>/dev/null > "$gitdirs"

  while IFS= read -r -d '' -u 4 gitdir; do
    local proj="${gitdir%/.git}"
    local name="${proj#$ROOT/}"
    [ "$name" = "$proj" ] && name="."
    local report="/tmp/housekeep_fixsec.$$.json"
    gitleaks detect --source "$proj" --no-git --report-format json --report-path "$report" >/dev/null 2>&1
    [ -s "$report" ] || { rm -f "$report"; continue; }
    local count
    count=$(python3 -c "import json;print(len(json.load(open('$report'))))" 2>/dev/null)
    [ "${count:-0}" = "0" ] && { rm -f "$report"; continue; }

    local findings="/tmp/housekeep_fixsec_findings.$$"
    python3 -c "
import json
d = json.load(open('$report'))
for x in d:
    print(f\"{x['RuleID']}|{x['File']}|{x.get('StartLine','?')}\")
" > "$findings"

    while IFS='|' read -r -u 5 rule file line; do
      echo
      echo "-- $name: $rule in ${file#$proj/} line $line --"
      echo "  [o]pen  [g]itignore this file  [s]kip"
      read -r -p "  action> " act
      case "$act" in
        o) "$editor" "$file" ;;
        g)
          echo "${file#$proj/}" >> "$proj/.gitignore"
          git -C "$proj" rm --cached "${file#$proj/}" >/dev/null 2>&1
          echo "  added to .gitignore, untracked from git"
          ;;
        *) : ;;
      esac
    done 5< "$findings"
    rm -f "$report" "$findings"
  done 4< "$gitdirs"
  rm -f "$gitdirs"
}

run_fix() {
  echo "== fix: space =="
  fix_space
  echo
  echo "== fix: git =="
  fix_git
  echo
  echo "== fix: security =="
  fix_security
}

case "$CMD" in
  space) run_space ;;
  security) run_security ;;
  git) run_git ;;
  fix) run_fix ;;
  all)
    if [ "$JSON" -eq 1 ]; then
      printf '{"space":'; run_space
      printf ',"security":'; run_security
      printf ',"git":'; run_git
      printf '}\n'
    else
      run_space
      echo
      run_security
      echo
      run_git
    fi
    ;;
esac
